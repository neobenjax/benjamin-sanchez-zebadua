{
  "name": "temp-portfolio",
  "version": "0.10.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/transpile-current-theme.mjs && next dev",
    "build": "node scripts/transpile-current-theme.mjs && node scripts/generate-tags.mjs && next build",
    "transpile:theme": "node scripts/transpile-current-theme.mjs",
    "start": "next start",
    "lint": "eslint",
    "lint:css": "node scripts/check-css-no-important.mjs",
    "validate:specs": "node scripts/validate-design-specs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/test-theme-tuner.mjs",
    "image:migrate": "node scripts/optimize-images.mjs --all",
    "image:staged": "node scripts/optimize-images.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "public/images/**/*.{jpg,jpeg,png}": [
      "pnpm run image:staged"
    ]
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-medium-image-zoom": "^5.4.3",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.4.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
